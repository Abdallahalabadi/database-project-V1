@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<header class="module-heading">
    <div>
        <h2>Dashboard</h2>
    </div>
</header>

<div class="erp-summary-row">
    <article class="erp-kpi-card green">
        <div>
            <span>Total Suppliers</span>
            <strong>@Model.dashboard.TotalSuppliers</strong>
        </div>
        <div class="erp-kpi-symbol">$</div>
    </article>

    <article class="erp-kpi-card blue">
        <div>
            <span>Total Inventory</span>
            <strong>@Model.dashboard.TotalInventory</strong>
        </div>
        <div class="erp-kpi-symbol">◫</div>
    </article>

    <article class="erp-kpi-card purple">
        <div>
            <span>Purchase Orders</span>
            <strong>@Model.dashboard.TotalOrders</strong>
        </div>
        <div class="erp-kpi-symbol">☻</div>
    </article>

    <article class="erp-kpi-card orange">
        <div>
            <span>Low Stock</span>
            <strong>@Model.dashboard.LowStockCount</strong>
        </div>
        <div class="erp-kpi-symbol">⛟</div>
    </article>
</div>

<div class="dashboard-erp-cards two-column-report">
    <section class="erp-card">
        <div class="erp-card-header">
            <h3>Recent Purchase Orders</h3>
        </div>

        @foreach (var order in Model.orders.Take(5))
        {
            <div class="purchase-card">
                <div>
                    <h4>#@order.PurchaseOrderId - @order.ProductName</h4>
                    <div class="supporting-text">@order.SupplierName</div>
                </div>
                <div style="text-align:right;">
                    <strong>$@order.TotalAmount</strong>
                    <div style="margin-top:6px;">
                        <span class="status-pill @(order.Status == "Completed" ? "good" : order.Status == "Pending" ? "pending" : "cancelled")">@order.Status</span>
                    </div>
                </div>
            </div>
        }
    </section>

    <section class="erp-card">
        <div class="erp-card-header">
            <h3>Inventory Overview</h3>
        </div>

        <div class="stock-meter-list">
            @foreach (var product in Model.products)
            {
                var width = Model.maxStock == 0 ? 0 : product.StockQuantity * 100 / Model.maxStock;
                <div class="stock-meter">
                    <strong>@product.ProductName</strong>
                    <div class="stock-track">
                        <div class="stock-fill" style="width:@width%"></div>
                    </div>
                    <span>@product.StockQuantity</span>
                </div>
            }
        </div>
    </section>
</div>
