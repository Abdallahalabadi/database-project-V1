@page
@model InventoryModel
@{
    ViewData["Title"] = "Inventory";
}

<header class="module-heading">
    <div>
        <h2>Inventory</h2>
    </div>
</header>

<section class="erp-card">
    <div class="erp-card-header">
        <h3>Inventory Tracking</h3>
    </div>

    <div class="erp-table-frame">
        <table>
            <thead>
                <tr><th>ID</th><th>Product</th><th>Category</th><th>Current Stock</th><th>Price</th><th>Status</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.products)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.ProductName</td>
                    <td>@item.CategoryName</td>
                    <td>@item.StockQuantity</td>
                    <td>$@item.Price</td>
                    <td>
                        @if (item.StockQuantity < 10)
                        {
                            <span class="status-pill stock-critical">Critical</span>
                        }
                        else if (item.StockQuantity < 20)
                        {
                            <span class="status-pill stock-low">Low Stock</span>
                        }
                        else
                        {
                            <span class="status-pill stock-available">Available</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
