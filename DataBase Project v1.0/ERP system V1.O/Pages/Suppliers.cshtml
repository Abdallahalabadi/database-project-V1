@page
@model SuppliersModel
@{
    ViewData["Title"] = "Suppliers";
}

<header class="module-heading">
    <div>
        <h2>Suppliers</h2>
    </div>
</header>

<section class="erp-card">
    <div class="erp-card-header">
        <h3>Supplier Management</h3>
    </div>

    <form method="post" asp-page-handler="Save" class="erp-entry-form">
        <input name="SupplierId" type="hidden" value="@Model.supplier.SupplierId" />

        <label>Supplier Name
            <input name="SupplierName" value="@Model.supplier.SupplierName" required />
        </label>

        <label>Contact Number
            <input name="ContactNumber" value="@Model.supplier.ContactNumber" required />
        </label>

        <label>Email
            <input name="Email" value="@Model.supplier.Email" required />
        </label>

        <label>Address
            <input name="Address" value="@Model.supplier.Address" required />
        </label>

        <div class="form-button-row">
            <button class="warq-button warq-save" type="submit">Save Supplier</button>
            <a class="warq-button warq-light" asp-page="/Suppliers">Clear</a>
        </div>
    </form>

    <div class="form-result-note">@Model.statusMessage</div>

    <div class="erp-table-frame">
        <table>
            <thead>
                <tr><th>ID</th><th>Name</th><th>Contact</th><th>Email</th><th>Address</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.suppliers)
            {
                <tr>
                    <td>@item.SupplierId</td>
                    <td>@item.SupplierName</td>
                    <td>@item.ContactNumber</td>
                    <td>@item.Email</td>
                    <td>@item.Address</td>
                    <td class="row-action-buttons">
                        <a class="warq-button warq-light" asp-page="/Suppliers" asp-route-editId="@item.SupplierId">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.SupplierId" onsubmit="return confirm('Delete this supplier?');">
                            <button class="warq-button warq-delete" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
