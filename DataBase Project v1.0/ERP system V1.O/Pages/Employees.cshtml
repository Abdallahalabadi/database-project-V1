@page
@model EmployeesModel
@{
    ViewData["Title"] = "Employees";
}

<header class="module-heading">
    <div>
        <h2>Employees</h2>
    </div>
</header>

<section class="erp-card">
    <div class="erp-card-header">
        <h3>Employee Management</h3>
    </div>

    <form method="post" asp-page-handler="Save" class="erp-entry-form">
        <input name="EmployeeId" type="hidden" value="@Model.employee.EmployeeId" />

        <label>First Name
            <input name="FirstName" value="@Model.employee.FirstName" required />
        </label>

        <label>Last Name
            <input name="LastName" value="@Model.employee.LastName" required />
        </label>

        <label>Position
            <input name="Position" value="@Model.employee.Position" required />
        </label>

        <label>Email
            <input name="Email" value="@Model.employee.Email" required />
        </label>

        <label>Phone
            <input name="Phone" value="@Model.employee.Phone" required />
        </label>

        <label>Salary
            <input name="Salary" value="@Model.employee.Salary" type="number" step="0.01" required />
        </label>

        <div class="form-button-row">
            <button class="warq-button warq-save" type="submit">Save Employee</button>
            <a class="warq-button warq-light" asp-page="/Employees">Clear</a>
        </div>
    </form>

    <div class="form-result-note">@Model.statusMessage</div>

    <div class="erp-table-frame">
        <table>
            <thead>
                <tr><th>ID</th><th>Name</th><th>Position</th><th>Email</th><th>Phone</th><th>Salary</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.employees)
            {
                <tr>
                    <td>@item.EmployeeId</td>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.Position</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>$@item.Salary</td>
                    <td class="row-action-buttons">
                        <a class="warq-button warq-light" asp-page="/Employees" asp-route-editId="@item.EmployeeId">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.EmployeeId" onsubmit="return confirm('Delete this employee?');">
                            <button class="warq-button warq-delete" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
