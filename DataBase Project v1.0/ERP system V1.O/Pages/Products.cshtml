@page
@model ProductsModel
@{
    ViewData["Title"] = "Products";
}

<header class="module-heading">
    <div>
        <h2>Products</h2>
    </div>
</header>

<section class="erp-card">
    <div class="erp-card-header">
        <h3>Product Management</h3>
    </div>

    <form method="post" asp-page-handler="Save" class="erp-entry-form">
        <input name="ProductId" type="hidden" value="@Model.product.ProductId" />

        <label>Product Name
            <input name="ProductName" value="@Model.product.ProductName" required />
        </label>

        <label>Category
            <select name="CategoryName">
                @foreach (var category in Model.categories)
                {
                    <option value="@category" selected="@(category == Model.product.CategoryName)">@category</option>
                }
            </select>
        </label>

        <label>Price
            <input name="Price" value="@Model.product.Price" type="number" step="0.01" required />
        </label>

        <label>Stock Quantity
            <input name="StockQuantity" value="@Model.product.StockQuantity" type="number" required />
        </label>

        <div class="form-button-row">
            <button class="warq-button warq-save" type="submit">Save Product</button>
            <a class="warq-button warq-light" asp-page="/Products">Clear</a>
        </div>
    </form>

    <div class="form-result-note">@Model.statusMessage</div>

    <div class="erp-table-frame">
        <table>
            <thead>
                <tr><th>ID</th><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.products)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.ProductName</td>
                    <td>@item.CategoryName</td>
                    <td>$@item.Price</td>
                    <td>@item.StockQuantity</td>
                    <td class="row-action-buttons">
                        <a class="warq-button warq-light" asp-page="/Products" asp-route-editId="@item.ProductId">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.ProductId" onsubmit="return confirm('Delete this product?');">
                            <button class="warq-button warq-delete" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
